{
    "checks": {
        "test": "bun test packages scripts --path-ignore-patterns='**/*.e2e.test.ts'",
        "slow_test": "bun test .e2e.test",
        "types": "bunx --bun tsc --noEmit && bunx --bun tsc --noEmit -p packages/board",
        "lint": "bun run lint"
    },
    "test_timeout_ms": 2400000,
    "test_case_timeout_ms": 2000,
    "run_budget_tokens": 15000000,
    "feature_map": "docs/feature-map",
    "test_file_patterns": ["packages/**/*.test.ts", "scripts/**/*.test.ts"],
    "test_helper_patterns": ["packages/**/testing/**"],
    "test_setup_files": [],
    "rule_files": ["docs/guides/coding-standards.md", "AGENTS.md"],
    "muninn": {
        "vault": "luca-monorepo"
    },
    "models": {
        "floors": { "test-writer": "sonnet" }
    }
}
