# dependencies (bun install)
node_modules

# output
out
dist
*.tgz

# harness templates (compiled output, not source — except agents and skills which have EJS branding)
packages/luca-framework/templates/harness/claude/hooks
packages/luca-framework/templates/harness/claude/rules
packages/luca-framework/templates/harness/claude/settings.json

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# mastracode runtime copies (generated from packages/luca-mastracode/ source files)
packages/luca-mastracode/.mastracode/
packages/luca-mastracode/.planning/

# generated output (built by build:all, deployed by deploy — source repo uses ~/.claude/ globally)
.claude/agents/
.claude/skills/
.claude/rules/
.claude/hooks/
.claude/statusline.sh
.claude/settings.json
.claude/.session-lock
.claude/.build-manifest.json

# context monitoring (runtime artifacts)
.planning/.context-metrics.json
.planning/.context-checkpoint.json
.planning/.luca-lock.json
.planning/session-ledger.jsonl
.planning/verification-history.jsonl
.planning/verification-result.json
.planning/luca-state.json
.planning/checks-convergence.json

# DAG workflow checkpoints (ephemeral local state)
.planning/checkpoints/

# Eval results (generated, per-run)
.planning/evals/

# tests — only the throwaway tmp files are ignored. The luca-mastracode
# package keeps its unit tests in src/__tests__/ (run via `bun test`); the
# previous wholesale exclusion (tied to a since-retired no-tests rule)
# meant Copilot/reviewers never saw the test files in PR diffs.
.tmp-test-*

# next.js
.next

# removed platform output directories (Claude Code is sole target)
.cursor/
.pi/
.qwen/

#Playwright CLI
.playwright-cli/

# Luca transient phase artifacts (per-iteration scratch, archived telemetry)
.planning/telemetry/archive/
.planning/**/checks-convergence.json
.planning/**/*-capture-*.md
.planning/audits/memory/state.json
