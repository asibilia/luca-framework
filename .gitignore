# DAG workflow checkpoints (ephemeral local state)
.planning/checkpoints/

# Eval results (generated, per-run)
.planning/evals/

# Luca workflow runtime state under the new .luca/ contract.
# Committed: config.json, roadmap.md (generated view), milestones/, archive/, phases/<slug>/{plan,research,context,verify,learn,audits/*}
# Ignored: per-run state, lock, ledger, telemetry, ephemeral CLI-handoff scratch
.luca/state.json
.luca/lock.json
.luca/ledger.jsonl
.luca/telemetry/
.luca/tmp/

# tests — only the throwaway tmp files are ignored. Packages keep their
# unit tests in src/__tests__/ (run via `bun test`) so they stay visible
# in PR diffs.
.tmp-test-*

# next.js
.next

# removed platform output directories (Claude Code is sole target)
.cursor/
.pi/
.qwen/

