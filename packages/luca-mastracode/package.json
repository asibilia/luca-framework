{
  "name": "@alecsibilia/luca-mastracode",
  "description": "Luca workflow as a custom Mastra Code distribution — custom modes, agents, subagents, and tools",
  "version": "12.0.0-alpha.16",
  "dependencies": {
    "@alecsibilia/luca-core": "workspace:*",
    "@mastra/core": "catalog:",
    "@mastra/libsql": "catalog:",
    "@mastra/memory": "catalog:",
    "mastracode": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "catalog:"
  },
  "main": "src/index.ts",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bunx --bun tsc --noEmit"
  },
  "type": "module"
}
