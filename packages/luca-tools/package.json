{
  "name": "@alecsibilia/luca-tools",
  "description": "Luca agent-environment artifacts — agent/skill/command/rule/hook definitions and the harness-shape compiler (private; bundled into @alecsibilia/luca)",
  "version": "13.0.0-alpha.9",
  "dependencies": {
    "@alecsibilia/luca-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./define": "./src/define/index.ts",
    "./compile": "./src/compile/index.ts",
    "./artifacts": "./src/artifacts/index.ts"
  },
  "main": "src/index.ts",
  "private": true,
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx --bun tsc --noEmit",
    "compile": "bun src/compile/bin/compile.ts",
    "compile:smoke": "bun src/compile/__fixtures__/compile-smoke.ts",
    "compile:artifacts": "bun src/compile/bin/compile.ts --manifest src/artifacts/index.ts"
  },
  "type": "module"
}
