{
  "name": "@alecsibilia/luca-framework",
  "description": "Luca CLI — bootstrap MuninnDB and launch the Mastra Code harness",
  "version": "12.0.0-alpha.13",
  "bin": {
    "luca": "./bin/luca.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@mastra/core": "catalog:",
    "@mastra/libsql": "catalog:",
    "@mastra/memory": "catalog:",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "citty": "^0.2.0",
    "consola": "^3.4.0",
    "mastracode": "catalog:",
    "pathe": "^2.0.3",
    "semver": "^7.6.0",
    "shell-quote": "^1.8.3",
    "update-notifier": "^7.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alecsibilia/luca-core": "workspace:*",
    "@alecsibilia/luca-mastracode": "workspace:*",
    "@types/semver": "^7.5.8",
    "@types/shell-quote": "^1.7.5",
    "@types/update-notifier": "^6.0.8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "keywords": [
    "agent",
    "ai",
    "cli",
    "luca",
    "mastracode",
    "muninndb"
  ],
  "module": "./dist/index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asibilia/luca-framework.git",
    "directory": "packages/luca-framework"
  },
  "scripts": {
    "build": "unbuild",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "bunx --bun tsc --noEmit",
    "validate": "bun run scripts/validate-package.ts"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
