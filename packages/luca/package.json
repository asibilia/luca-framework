{
    "name": "@alecsibilia/luca",
    "description": "Luca: turns a spec on GitHub Issues into a reviewed pull request, run from Paseo with Claude Code",
    "version": "14.0.0-alpha.7",
    "license": "Apache-2.0",
    "author": "Alec Sibilia <sibilia.alec@gmail.com>",
    "homepage": "https://github.com/asibilia/luca-framework#readme",
    "bugs": {
        "url": "https://github.com/asibilia/luca-framework/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/asibilia/luca-framework.git",
        "directory": "packages/luca"
    },
    "type": "module",
    "engines": {
        "bun": ">=1.3.0"
    },
    "bin": {
        "luca": "engine/cli/luca.ts",
        "luca-run": "engine/cli/luca-run.ts"
    },
    "files": [
        "engine/",
        "board/",
        "skills/",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "prepack": "bun scripts/copy-sources.ts",
        "postpack": "bun scripts/copy-sources.ts --clean",
        "typecheck": "bunx --bun tsc --noEmit -p ."
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "0.3.273",
        "@getpaseo/client": "0.9.1",
        "@getpaseo/plugin": "0.9.1",
        "@modelcontextprotocol/sdk": "1.30.0",
        "lodash": "^4.17.21",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "typescript": "catalog:"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "agent",
        "ai",
        "claude-code",
        "luca",
        "paseo",
        "spec-driven"
    ]
}
