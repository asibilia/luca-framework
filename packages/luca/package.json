{
  "name": "@alecsibilia/luca",
  "description": "Luca — spec-driven agentic development workflow for Claude Code (umbrella; bundles luca-cli, luca-core, luca-tools)",
  "version": "13.0.0-alpha.13",
  "license": "Apache-2.0",
  "author": "Alec Sibilia <sibilia.alec@gmail.com>",
  "homepage": "https://github.com/asibilia/luca-framework#readme",
  "bugs": {
    "url": "https://github.com/asibilia/luca-framework/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "bin": {
    "luca": "./bin/luca.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "citty": "^0.2.0",
    "consola": "^3.4.0",
    "pathe": "^2.0.3",
    "semver": "^7.6.0",
    "shell-quote": "^1.8.3",
    "update-notifier": "^7.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@alecsibilia/luca-cli": "workspace:*",
    "@alecsibilia/luca-core": "workspace:*",
    "@alecsibilia/luca-tools": "workspace:*",
    "@types/bun": "latest",
    "@types/semver": "^7.5.8",
    "@types/shell-quote": "^1.7.5",
    "@types/update-notifier": "^6.0.8",
    "typescript": "catalog:",
    "unbuild": "^3.5.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agent",
    "ai",
    "cli",
    "claude-code",
    "luca",
    "muninndb",
    "workflow",
    "spec-driven"
