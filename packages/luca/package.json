  "module": "./dist/index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asibilia/luca-framework.git",
    "directory": "packages/luca"
  },
  "scripts": {
    "build": "unbuild",
    "prepublishOnly": "bun run build",
    "typecheck": "bunx --bun tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.mts"
