#!/bin/sh
# Refuses a commit that stages a file over 5,000 tokens (bytes / 4), and says
# how to split it. Turned on by `bun install` (the "prepare" script sets
# core.hooksPath to .githooks). Luca's own commits skip hooks (--no-verify);
# Luca enforces the same limit through `bun run lint`.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec bun scripts/check-file-size.ts --staged
