{
  "name": "luca-monorepo",
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@alecsibilia/commit": "^1.0.8",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9",
    "@next/eslint-plugin-next": "^16.2.4",
    "@types/bun": "latest",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.0",
    "unbuild": "^3.5.0"
  },
  "private": true,
  "scripts": {
    "build": "cd packages/luca && bun run build",
    "changeset": "changeset",
    "commit": "bunx --bun @alecsibilia/commit",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "mastracode": "bun run packages/luca-mastracode/src/index.ts",
    "publish:framework": "cd packages/luca-framework && bun publish --access restricted",
    "release": "changeset publish",
    "release:local": "bun run build && cd packages/luca && bun link",
    "test": "bun run --filter '*' test",
    "version": "changeset version && bun install"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@eslint/js": "^9",
      "@mastra/core": "1.34.0",
      "@mastra/libsql": "1.10.1",
      "@mastra/memory": "1.18.1",
      "@next/eslint-plugin-next": "^16.2.4",
      "eslint": "^9",
      "eslint-import-resolver-typescript": "^4.4.4",
      "eslint-plugin-import": "^2.32.0",
      "eslint-plugin-prettier": "^5.5.5",
      "globals": "^17.5.0",
      "mastracode": "0.19.0",
      "prettier": "^3.8.3",
      "typescript": "^5.0.0",
      "typescript-eslint": "^8.59.0",
      "zod": "^4.3.6"
    }
  }
}
