{
  "name": "luca-monorepo",
  "dependencies": {
    "@playwright/cli": "^0.1.1",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.23",
    "xstate": "^5.28.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@alecsibilia/commit": "^1.0.8",
    "@mariozechner/pi-coding-agent": "^0.55.1",
    "@mariozechner/pi-tui": "^0.55.1",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.23",
    "typescript": "^5.0.0",
    "unbuild": "^3.5.0"
  },
  "private": true,
  "scripts": {
    "build": "bun run build:all",
    "build:all": "bun run ./scripts/build-all.ts && bun run build:templates",
    "build:templates": "bun run ./scripts/copy-harness-templates.ts",
    "check:drift": "bun run ./scripts/check-drift.ts",
    "commit": "bunx --bun @alecsibilia/commit",
    "css:observer": "bun run --filter @alecsibilia/luca-observer css:build",
    "deploy": "bun run ./scripts/deploy-global.ts",
    "deploy:copy": "bun run ./scripts/deploy-global.ts --copy",
    "deploy:remove": "bun run ./scripts/deploy-global.ts --remove",
    "dev:observer": "bun run --filter @alecsibilia/luca-observer dev",
    "eval:skills": "bun scripts/eval-skills.ts",
    "generate:from-cursor": "bun run ./scripts/generate-agents-from-cursor.ts && bun run ./scripts/generate-skills-from-cursor.ts && bun run ./scripts/generate-rules-from-cursor.ts"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}
