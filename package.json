{
  "name": "luca-monorepo",
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@alecsibilia/commit": "^1.0.8",
    "@types/bun": "latest",
    "typescript": "^5.0.0",
    "unbuild": "^3.5.0"
  },
  "private": true,
  "scripts": {
    "build": "cd packages/luca-framework && bun run build",
    "commit": "bunx --bun @alecsibilia/commit",
    "css:studio": "bun run --filter @alecsibilia/luca-studio css:build",
    "dev:studio": "bun run --filter @alecsibilia/luca-studio dev",
    "mastracode": "bun run packages/luca-mastracode/src/index.ts",
    "publish:framework": "cd packages/luca-framework && npm publish --access restricted",
    "release:local": "bun run build && cd packages/luca-framework && bun link"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}
