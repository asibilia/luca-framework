{
  "name": "luca-monorepo",
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@alecsibilia/commit": "^1.0.8",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "latest",
    "typescript": "^5.0.0",
    "unbuild": "^3.5.0"
  },
  "private": true,
  "scripts": {
    "build": "cd packages/luca && bun run build",
    "changeset": "changeset",
    "commit": "bunx --bun @alecsibilia/commit",
    "release": "changeset publish",
    "release:local": "bun run build && cd packages/luca && bun link",
    "test": "bun run --filter '*' test",
    "version": "changeset version && bun install"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "typescript": "^5.0.0",
      "zod": "^4.3.6"
    }
  }
}
